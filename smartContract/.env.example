# Proyek ini menggunakan Hardhat Configuration Variables versi terbaru.
# File .env ini tidak digunakan secara langsung oleh sistem dan hanya berfungsi sebagai dokumentasi.
#
# Jangan menulis Private Key di dalam file ini atau membuat file .env
# 
# Cara setup:
# Jalankan perintah terminal untuk menyimpan variabel:
#
# 1. Untuk Polygon Amoy Testnet:
#    npx hardhat vars set POLYGON_AMOY_RPC_URL
#    npx hardhat vars set POLYGON_AMOY_PRIVATE_KEY
#
# 2. Untuk Ethereum Sepolia Testnet (Opsional):
#    npx hardhat vars set SEPOLIA_RPC_URL
#    npx hardhat vars set SEPOLIA_PRIVATE_KEY
#
# Untuk melihat variabel yang sudah di-set: npx hardhat vars list
#
# Itu aja >_<

POLYGON_AMOY_RPC_URL="https://polygon-amoy.infura.io/v3/..."
POLYGON_AMOY_PRIVATE_KEY="0x..."

SEPOLIA_RPC_URL="https://eth-sepolia.g.alchemy.com/v2/..."
SEPOLIA_PRIVATE_KEY="0x..."
