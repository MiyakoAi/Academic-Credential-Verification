# Server
PORT=3001

# Pinata / IPFS
PINATA_JWT=your_pinata_jwt_token_here
PINATA_GATEWAY=your-gateway.mypinata.cloud

# Blockchain
# For development, use Hardhat local node (npx hardhat node)
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
CONTRACT_ADDRESS=0x_deployed_contract_address_here

# Private key for signing transaction dari backend (optional)
# Usually for metadata synchronization
# Main transaction is done via MetaMask in the frontend
SIGNER_PRIVATE_KEY=0x_your_private_key_here

# Frontend URL (for CORS and QR Code URL)
FRONTEND_URL=http://localhost:3000
VERIFICATION_BASE_URL=http://localhost:3000/verify
